<?xml version="1.0" encoding="utf-8" ?>
<pages:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackMyTrain.Maui.Pages.TrainsSearchPage"
             xmlns:pages="clr-namespace:TrackMyTrain.Maui.Pages"
             xmlns:controls="clr-namespace:TrackMyTrain.Maui.Pages.Controls"
             xmlns:conv="clr-namespace:TrackMyTrain.Maui.Utilities"
             xmlns:model="clr-namespace:TrackMyTrain.Data.Implementations;assembly=TrackMyTrain.Data.Implementations"
             xmlns:vm="clr-namespace:TrackMyTrain.Maui.ViewModels"
             x:Name="this"
             x:DataType="vm:TrainsSearchViewModel"
             x:TypeArguments="vm:TrainsSearchViewModel">
    <ContentPage.Resources>
        <ResourceDictionary>
            <!--<toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />-->
            <conv:TextTitleCaseConverter x:Key="TextTitleCaseConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>
    <Grid RowDefinitions="*">
        <VerticalStackLayout Padding="10" Spacing="10">
            <!-- Header Section -->
            <Frame CornerRadius="8"
                       Padding="12"
                       HasShadow="True"
                       Margin="3,0,3,10"
                       BackgroundColor="#fffdf8">
            
                <VerticalStackLayout  Spacing="8">
                    <Label Text="Inserisci il numero del treno" FontSize="16" FontAttributes="Bold" TextColor="#333"/>
                    <SearchBar x:Name="searchBar" Keyboard="Numeric" SearchCommand="{Binding SearchTrainCommand}" BackgroundColor="Transparent" SearchCommandParameter="{Binding Text, x:DataType='searchBar', Source={x:Reference searchBar}}"  HorizontalOptions="Start" Placeholder="Numero treno" FontSize="14" Text="{Binding CurrentTrain}"/>
                </VerticalStackLayout>

            </Frame>
            <!-- Search bar -->
            <!--<SearchBar x:Name="searchBar" Shadow="True" SearchCommand="{Binding LoadResultsCommand}" SearchCommandParameter="{Binding Text, x:DataType='searchBar', Source={x:Reference searchBar}}"  HorizontalOptions="Start" Placeholder="Numero treno" FontSize="14" Text="{Binding CurrentTrain}"/>-->
            <!--<Entry Placeholder="Numero del treno" Text="{Binding CurrentTrain}" />
            <Button Text="Search" Command="{Binding LoadResultsCommand}" CommandParameter="{Binding CurrentTrain}" />-->
            <!-- Train list -->
            <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}" RefreshColor="Transparent">
                <ScrollView>
                    <CollectionView x:Name="collectionView" ItemsSource="{Binding RecentTrains}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:RecentTrain">
                            <Frame CornerRadius="0"
                                   Padding="6"
                                   HasShadow="True"
                                   Margin="3,0,3,0"
                                   BackgroundColor="#fffdf8">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Path=Viewmodel.LoadTrainDetailsCommand, Source={x:Reference this}}" CommandParameter="{Binding}"/>
                                </Frame.GestureRecognizers>
                                <Grid BackgroundColor="#fffdf8" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,0">
                                    <VerticalStackLayout Grid.Row="0" Grid.ColumnSpan="3" Spacing="4" Margin="8,0,0,0">
                                        <Label Grid.Column="0" Text="{Binding DepartureStationName, Converter={StaticResource TextTitleCaseConverter}}" FontSize="15" FontAttributes="Bold" TextColor="#333"/>
                                        <StackLayout Orientation="Horizontal" Spacing="16">
                                            <Label Text="Partenza" FontSize="14" TextColor="#666"/>
                                            <Label Text="{Binding DepartureTime}" FontSize="14" TextColor="#666"/>
                                            
                                        </StackLayout>
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding ArrivalStationName, Converter={StaticResource TextTitleCaseConverter}}" FontSize="15" FontAttributes="Bold" TextColor="#333"/>
                                        <StackLayout Orientation="Horizontal" Spacing="16">
                                            
                                            <Label Text="Arrivo" FontSize="14" TextColor="#333"/>
                                            <Label Text="{Binding ArrivalTime}" FontSize="14" TextColor="#666"/>
                                        </StackLayout>
                                        <!--<Label Grid.Column="0" Text="{Binding ArrivalStationName}" FontSize="14" TextColor="#666"/>
                                        <StackLayout Orientation="Horizontal" Spacing="16">
                                            <Label Text="Arrivo" FontSize="14" TextColor="#333"/>
                                            <Label Text="{Binding ArrivalTime}" FontSize="14" TextColor="#666"/>
                                            --><!--#4CAF50--><!--
                                        </StackLayout>-->
                                    </VerticalStackLayout>
                                    <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                        <Label Text="{Binding CurrentDelay,StringFormat='{}{0}\''}" Grid.Column="2" FontSize="14" FontAttributes="Bold" />
                                        <Image Source="alert.png" IsVisible="{Binding HasWarning}" />
                                    </StackLayout>
                                </Grid>
                            </Frame>



                            <!--<Frame BorderColor="#e0e0e0"
                                   CornerRadius="5"
                                   Padding="10"
                                   HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10">

                                    --><!-- Train info --><!--
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Number}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Start" />

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding DepartureStationName}"
                                           FontAttributes="Bold"
                                           VerticalOptions="Start" />
                                    
                                    --><!-- Departure --><!--
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding ArrivalStationName}"
                                           FontAttributes="Bold" />

                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{Binding DepartureTime}" />

                                    --><!-- Arrival --><!--
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{Binding ArrivalTime}"
                                           FontAttributes="Bold" />

                                    <Label Grid.Row="2" Grid.Column="1"
                                           Text="{Binding CurrentDelay}" />

                                </Grid>
                            </Frame>-->
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                </ScrollView>
            </RefreshView>
        </VerticalStackLayout>
        <controls:CustomActivityIndicator IsVisible="{Binding LoadDataCommand.IsRunning}" />
    </Grid>
</pages:BaseContentPage>