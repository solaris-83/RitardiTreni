<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             CanBeDismissedByTappingOutsideOfPopup="True"
             xmlns:vm="clr-namespace:TrackMyTrain.Maui.ViewModels"
             Background="{StaticResource Gray200}"
             x:DataType="vm:CategoriesPopupViewModel"
             x:TypeArguments="system:String"
             x:Class="TrackMyTrain.Maui.Pages.CategoriesPopup">
    <Grid>
        <CollectionView 
            ItemsSource="{Binding Categories}"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="system:String">
                    <StackLayout>
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type toolkit:Popup}},Path=BindingContext.CloseCommand}" CommandParameter="{Binding}" />
                        </StackLayout.GestureRecognizers>
                        <Label Grid.Column="1" Padding="10" HorizontalTextAlignment="Center"
                            Text="{Binding .}" TextColor="{StaticResource Gray700}"
                            FontSize="15">
                            </Label>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</toolkit:Popup>
