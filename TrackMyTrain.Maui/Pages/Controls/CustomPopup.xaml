<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackMyTrain.Maui.Pages.Controls.CustomPopup">

    <Frame CornerRadius="10" Padding="10" HasShadow="True" BorderColor="{StaticResource BrandColor}" Background="White">

        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Header -->
            <Label Text="Popup Header"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

            <!-- Message -->
            <Label Text="This is your custom popup message."
               FontSize="16"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center" />

            <!-- Button -->
            <Button Text="OK"
                    Command="{Binding CloseCommand}"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Frame>

</ContentView>
