<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackMyTrain.Maui.Pages.Controls.CustomActivityIndicator">
    <ContentView.Resources>
        <Style x:Key="gridStyle" TargetType="Grid">
            <Setter Property="BackgroundColor" Value="{StaticResource Gray300}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ContentView.Resources>
        <!-- Modal overlay -->
    <Grid Style="{StaticResource gridStyle}">
        <ActivityIndicator IsRunning="True" Background="Transparent" Color="{StaticResource BrandColor}"
                                ZIndex="100"
                               HeightRequest="100" 
                               WidthRequest="100" />
    </Grid>
  
</ContentView>
